# Copy to .env for local development. On Vercel, set these in Project > Settings > Environment Variables.
# Keys for Razorpay, email, WhatsApp and translation can also be entered later in Admin > Settings > Integrations.

# Database (Vercel: connect Neon from the Storage tab, it sets DATABASE_URL for you).
# Leave empty locally to use the built-in database in ./data/pglite
DATABASE_URL=

# Admin login: login ID "admin" (or this email) + this password
ADMIN_EMAIL=admin@astrologytalk.local
ADMIN_PASSWORD=Admin@123

# Long random text that signs login sessions
JWT_SECRET=change-me-to-a-long-random-string

# Address of the website (the frontend), used in emails and WhatsApp messages
SITE_URL=http://localhost:8090
SITE_NAME=Astrology Talk

# Prices in rupees (can be changed in Admin > Settings)
REPORT_PRICE=499
CONSULT_PRICE=999

# Razorpay (UPI / PhonePe / GPay / cards). Empty = demo payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Gmail: smtp.gmail.com, 587, your address, a 16-letter App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFY_EMAIL=

# WhatsApp (meta = WhatsApp Cloud API, or twilio)
WHATSAPP_PROVIDER=
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=en
ADMIN_WHATSAPP=
DEFAULT_COUNTRY_CODE=91

# Optional: server-side translation of reports, and free-form smart answers
GOOGLE_TRANSLATE_API_KEY=
ANTHROPIC_API_KEY=

# Local only: Chrome or Edge used to make PDFs (found automatically on Windows)
CHROME_PATH=
