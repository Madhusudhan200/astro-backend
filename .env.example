# ---- Site ----
PORT=8090
SITE_NAME=Astrology Talk
SITE_URL=http://localhost:8090
JWT_SECRET=change-me-to-a-long-random-string
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# ---- Admin login (created on first start) ----
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisStrongPassword!
# Where to send "new registration / payment / booking" alerts
ADMIN_NOTIFY_EMAIL=
ADMIN_WHATSAPP=

# ---- Prices in INR (can also be changed in Admin > Settings) ----
REPORT_PRICE=499
CONSULT_PRICE=999

# ---- AI report writer (Claude). Leave empty to use the rule-based fallback ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Razorpay (leave empty for DEMO payment mode) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (SMTP). Gmail: smtp.gmail.com / 587 with an App Password ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Astrology Talk <no-reply@yourdomain.com>"

# ---- WhatsApp: WHATSAPP_PROVIDER = meta | twilio ----
WHATSAPP_PROVIDER=
DEFAULT_COUNTRY_CODE=91
# Meta WhatsApp Cloud API
META_WA_TOKEN=
META_WA_PHONE_ID=
# Approved template with one body variable {{1}} (needed for business-initiated messages)
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=en
# Twilio WhatsApp
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WA_FROM=+14155238886
